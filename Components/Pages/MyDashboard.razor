@page "/dashboard"
@using DashboardData.Models
@rendermode InteractiveServer
@using DashboardData.Services
@using Radzen
@using Radzen.Blazor
@using System.Text.Json
@inject ISensorService SensorService
@inject NavigationManager NavManager
@using DashboardData.Components.UI

@inject UserCounterService S1
@inject UserCounterService S2



<h3>MyDashboard</h3>

<PageTitle>Mon Dashboard Data </PageTitle>

<h1>Tableau de Bord</h1>

<div class="alert alert-info">
	Bienvenue sur l'interface de pilotage
	Nous sommes le : <strong>@DateTime.Now.ToString("yy-MM-dd")</strong>
</div>

<p>
	Status du systéme ; 
	
	@if (IsSystemOK)
	{
		<span class="badge bg-success">Opérationnel</span>
	}
	else
	{
		<span class="badge bg-danger"> Erreur Critique</span>
	}

</p>

<button class="btn btn-primary" @onclick="RefreshSystem">
	<span class="bi bi-arrow-repeat"></span>Actualiser le status
</button>

<div class="mt-3 card card-body">
	Logs : @LastLog
</div>

<div class="row mb-4">
    <div class="col-md-4 mb-3">
        <!-- On passe les paramètres comme de simples attributs HTML -->
        <KpiCard Title="Total Sondes" Value="@TotalSondes.ToString()"
                 BackgroundColorClass="bg-primary" IconClass="bi-box-seam" />
    </div>
    <div class="col-md-4 mb-3">
        <KpiCard Title="Moyenne Globale" Value="@($"{Moyenne:F1} °C")"
                 BackgroundColorClass="bg-success" IconClass="bi-bullseye" />
    </div>
    <div class="col-md-4 mb-3">
        <KpiCard Title="Alerte Max" Value="@($"{Max:F1} °C")"
                 BackgroundColorClass="bg-danger" IconClass="bi-exclamation-triangle-fill" />
    </div>

	<div class="col-md-4">
		<div class="card shadow-sm h-100">
			<div class="card-header bg-white">
				<h5 class="mb-0"><i class="bi bi-speedometer2 text-danger"></i> Valeur Max Détectée</h5>
			</div>
			<div class="card-body text-center d-flex flex-column justify-content-center">
            
				<RadzenRadialGauge Style="width: 100%; height: 250px;">
					<RadzenRadialGaugeScale StartAngle="0" EndAngle="100" Step="20">
						<RadzenRadialGaugeScalePointer Value="@Max" Length="0.6" ShowValue="true" />
						<!-- Zone verte -->
						<RadzenRadialGaugeScaleRange From="0" To="40" Fill="green" />
						<!-- Zone orange -->
						<RadzenRadialGaugeScaleRange From="40" To="70" Fill="orange" />
						<!-- Zone rouge -->
						<RadzenRadialGaugeScaleRange From="70" To="100" Fill="red" />
					</RadzenRadialGaugeScale>
				</RadzenRadialGauge>

			</div>
		</div>
	</div>

</div>

@if (_isLoading)
{
	<p><em>Chargement des données</em></p>
}
else
{
	<button class="btn btn-outline-secondary mb-3" @onclick="() => ShowAsCards = !ShowAsCards">
		<i class="bi bi-arrow-left-right"></i> Changer de Vue
	</button>

	@if (ShowAsCards)
	{
		<div class="row">
			@foreach (var s in Sensors ?? new())
			{
				<div class="col-md-3 mb-3">
					<SensorCard Sensor="s" />
				</div>
			}
		</div>
	}
	else
	{
		<SensorTable Sensors="FilteredSensors" OnDeleteClicked="DeleteSensor" />
	}
}

<button class="btn btn-success mb-3" @onclick='() => NavManager.NavigateTo("/add-sensor")'>
	<span class="bi bi-plus-circle"></span> Ajouter un capteur
</button>

<div class="mt-4 p-3 border rounded bg-light">
	<h4>Test des Durées de Vie</h4>
	<p>Valeur de S1 : <strong>@S1.Count</strong></p>
	<p>Valeur de S2 : <strong>@S2.Count</strong></p>
    
	<button class="btn btn-warning" @onclick="IncrementTests">
		Incrémenter les compteurs
	</button>
</div>


<button class="btn btn-secondary mb-3" @onclick="LoadAll">Toutes les sondes</button>
<button class="btn btn-danger mb-3" @onclick="LoadCritical">Alertes (> 30.0)</button>
<a href="/edit-sensor" class="btn btn-success mb-3">+ Nouveau Capteur</a>

@if (Sensors == null)
{
    <p>Chargement en cours...</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Capteur</th>
                <th>Lieu</th>
                <th>Valeur Courante</th>
				<th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var sensor in Sensors)
            {
                <tr>
                    <td>@sensor.Name</td>
                    <!-- Grâce au Include(), Location n'est pas nul ! -->
                    <td>@(sensor.Location?.Name ?? "Non défini")</td>
                    <td>@sensor.Value</td>
					<td>
						<a href="/edit-sensor/@sensor.Id" class="btn btn-sm btn-outline-primary">Éditer</a>

						@* Bouton Supprimer *@
						<button class="btn btn-sm btn-outline-danger"
								@onclick="() => DeleteSensor(sensor.Id)">
							Supprimer
						</button>
					</td>
                </tr>
            }
        </tbody>
    </table>
}



<!-- On relie l'événement de l'enfant à la méthode DeleteSensor du parent -->
<SensorTable Sensors="Sensors" OnDeleteClicked="DeleteSensor" />

<!-- Exercice 2 : Donut Chart affichant la répartition du nombre de sondes par lieu -->
<div class="row mt-4">
	<div class="col-md-6">
		<div class="card shadow-sm">
			<div class="card-header bg-white">
				<h5 class="mb-0"><i class="bi bi-pie-chart-fill text-info"></i> Répartition des sondes</h5>
			</div>
     <div class="card-body">
            @if (CountStats != null && CountStats.Any())
			{
                <RadzenChart Style="width:100%; height:300px;" SeriesClick="OnChartClick">
					<RadzenDonutSeries Data="@CountStats" CategoryProperty="LocationName" ValueProperty="Count">
						<TitleTemplate>
							<div class="rz-donut-content text-center">
								<div>Total</div>
								<div><strong>@TotalSondes</strong></div>
							</div>
						</TitleTemplate>
					</RadzenDonutSeries>
				</RadzenChart>

				<div class="mt-2 small text-muted">Debug CountStats JSON: @JsonSerializer.Serialize(CountStats)</div>
			}
			else
			{
				<div class="text-center text-muted">Aucune donnée pour le graphique</div>
               @if (CountStats != null)
				{
					<div class="mt-2 small text-muted">CountStats présent mais vide: @JsonSerializer.Serialize(CountStats)</div>
				}
			}
		</div>
		</div>
	</div>
</div>

@code {
	private bool ShowAsCards = false;
	private bool IsSystemOK = true;
	private int RequestCount = 0;
	private string LastLog = "Rien a signaler";
	private List<SensorData> _sensors = new();
	private bool _isLoading = true;
    private List<SensorData>? Sensors;

	private int TotalSondes;  // Nombre total de capteurs
	private double Moyenne;  // Moyenne de toutes les valeurs
	private double Max;// Valeur maximale

	private List<LocationStat> LocationStats = new();

	// Nombre de capteurs par lieu (pour le donut chart)
	private List<LocationCountStat> CountStats = new();


	private void RefreshSystem()
	{
		RequestCount++;
		var nrd = new Random();
		IsSystemOK = nrd.Next(0, 10) > 2;

		if (IsSystemOK)
		{
			LastLog = $"Check {RequestCount} : Tout va bien ";
		}
		else
		{
			LastLog = $"Chech {RequestCount} : Anomalie détectée";
		}
	}

	protected override async Task OnInitializedAsync()
	{
		// 1. Charger la liste complète des capteurs
		await LoadAll();

		// 2. Appeler chaque méthode d’agrégation
		//    Chaque appel génère une requête SQL optimisée
		TotalSondes = await SensorService.GetTotalCountAsync();
		Moyenne = await SensorService.GetAverageValueAsync();
		Max = await SensorService.GetMaxValueAsync();

       LocationStats = await SensorService.GetAverageValueByLocationAsync();

        // Récupère la répartition du nombre de sondes par lieu (exercice 2)
		CountStats = await SensorService.GetSensorCountByLocationAsync();

		// Si la méthode ci-dessus ne retourne rien, tenter l'autre méthode de l'interface
		if (CountStats == null || !CountStats.Any())
		{
			CountStats = await SensorService.GetCountStatsAsync();
		}

		// Fin du chargement
		_isLoading = false;
	}

	private void IncrementTests()
	{
		S1.Increment();
	}

    private async Task LoadAll()
    {
        Sensors = await SensorService.GetSensors();
    }

    private async Task LoadCritical()
    {
        Sensors = await SensorService.GetCriticalSensorsAsync(30.0);
    }


	private async Task DeleteSensor(int id)
	{
		await SensorService.DeleteSensorAsync(id);  // DELETE en BDD
		await LoadAll();  // Recharge la liste → tableau mis à jour instantanément
	}

	private string? SelectedLocationFilter = null;

	// Cette méthode sera appelée par Radzen
	private void OnChartClick(SeriesClickEventArgs args)
	{
		// args.Category contient le nom du lieu cliqué (ex: "Labo")
		string clickedLocation = args.Category.ToString();

		// Bascule (Toggle) : si on reclique sur le même, on annule le filtre
		if (SelectedLocationFilter == clickedLocation)
			SelectedLocationFilter = null;
		else
			SelectedLocationFilter = clickedLocation;
	}

	// On crée une propriété calculée qui filtre la liste pour le tableau
	private List<SensorData> FilteredSensors => SelectedLocationFilter == null
		 ? Sensors
		 : Sensors.Where(s => s.Location?.Name == SelectedLocationFilter).ToList();
	

}
