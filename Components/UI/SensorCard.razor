@using DashboardData.Models

<div class="card shadow-sm mb-3" style="max-width: 300px;">
    <div class="card-body">
        <div class="d-flex align-items-center mb-2">
            <i class="bi bi-thermometer-half fs-3 text-danger me-2"></i>
            <h5 class="card-title mb-0">@Sensor.Name</h5>
        </div>

        <p class="card-text fs-4 fw-bold text-primary">
            @Sensor.Value
        </p>

        <p class="card-text text-muted">
            <i class="bi bi-geo-alt-fill me-1"></i>
            @(Sensor.Location?.Name)
        </p>
    </div>
</div>

@code{
    [Parameter]
    public SensorData Sensor { get; set; }
}